// Prisma Database Schema for DairySphere PWA SaaS
// Baseline Foundation, Milk Operations & Financial/Ledger Domain (EP-012D, EP-012E & EP-012F)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum FarmerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerType {
  WHOLESALE
  RETAIL
  INSTITUTIONAL
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum MilkType {
  COW
  BUFFALO
  BOTH
}

enum MilkShift {
  MORNING
  EVENING
}

enum RateChartType {
  COLLECTION
  SALE
}

enum RateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AccountType {
  FARMER
  CUSTOMER
  GENERAL
}

enum EntryType {
  DEBIT
  CREDIT
}

enum BillType {
  FARMER_BILL
  CUSTOMER_INVOICE
}

enum BillStatus {
  DRAFT
  FINALIZED
  PAID
  PARTIALLY_PAID
  VOID
  REVISED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  ADJUSTMENT
}

enum PaymentStatus {
  COMPLETED
  REVERSED
  PENDING
  FAILED
}

enum PaymentType {
  FARMER_PAYMENT
  CUSTOMER_RECEIPT
}

enum AdjustmentType {
  CREDIT_NOTE
  DEBIT_NOTE
  INCENTIVE
  DEDUCTION
  CORRECTION
  REVERSAL
}

// ==========================================
// SYSTEM FOUNDATION DOMAIN
// ==========================================

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @unique @db.VarChar(50)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  companies            Company[]
  branches             Branch[]
  users                User[]
  roles                Role[]
  userRoles            UserRole[]
  userBranchAccesses   UserBranchAccess[]
  auditLogs            AuditLog[]
  farmers              Farmer[]
  customers            Customer[]
  products             Product[]
  rateCharts           RateChart[]
  milkCollections      MilkCollection[]
  milkSales            MilkSale[]
  ledgerAccounts       LedgerAccount[]
  ledgerEntries        LedgerEntry[]
  bills                Bill[]
  payments             Payment[]
  financialAdjustments FinancialAdjustment[]

  @@map("tenants")
}

model Company {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  name          String        @db.VarChar(255)
  code          String        @db.VarChar(50)
  taxIdentifier String?       @map("tax_identifier") @db.VarChar(50)
  status        CompanyStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches             Branch[]
  farmers              Farmer[]
  customers            Customer[]
  products             Product[]
  rateCharts           RateChart[]
  milkCollections      MilkCollection[]
  milkSales            MilkSale[]
  ledgerAccounts       LedgerAccount[]
  ledgerEntries        LedgerEntry[]
  bills                Bill[]
  payments             Payment[]
  financialAdjustments FinancialAdjustment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @db.VarChar(50)
  address   String?      @db.Text
  phone     String?      @db.VarChar(20)
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userBranchAccesses   UserBranchAccess[]
  farmers              Farmer[]
  customers            Customer[]
  rateCharts           RateChart[]
  milkCollections      MilkCollection[]
  milkSales            MilkSale[]
  ledgerAccounts       LedgerAccount[]
  ledgerEntries        LedgerEntry[]
  bills                Bill[]
  payments             Payment[]
  financialAdjustments FinancialAdjustment[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String     @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles          UserRole[]
  userBranchAccesses UserBranchAccess[]
  auditLogs          AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserBranchAccess {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId])
  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branch_accesses")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(255)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ==========================================
// BASIC MASTER DOMAINS
// ==========================================

model Farmer {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  companyId  String       @map("company_id") @db.Uuid
  branchId   String       @map("branch_id") @db.Uuid
  farmerCode String       @map("farmer_code") @db.VarChar(50)
  firstName  String       @map("first_name") @db.VarChar(100)
  lastName   String       @map("last_name") @db.VarChar(100)
  phone      String?      @db.VarChar(20)
  email      String?      @db.VarChar(255)
  status     FarmerStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  details              FarmerDetails?
  milkCollections      MilkCollection[]
  ledgerAccounts       LedgerAccount[]
  bills                Bill[]
  payments             Payment[]
  financialAdjustments FinancialAdjustment[]

  @@unique([branchId, farmerCode])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@map("farmers")
}

model FarmerDetails {
  id                String    @id @default(uuid()) @db.Uuid
  farmerId          String    @unique @map("farmer_id") @db.Uuid
  bankName          String?   @map("bank_name") @db.VarChar(100)
  bankAccountNo     String?   @map("bank_account_no") @db.VarChar(50)
  bankIfscCode      String?   @map("bank_ifsc_code") @db.VarChar(20)
  nationalId        String?   @map("national_id") @db.VarChar(50)
  address           String?   @db.Text
  preferredMilkType MilkType? @map("preferred_milk_type")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("farmer_details")
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  branchId     String         @map("branch_id") @db.Uuid
  customerCode String         @map("customer_code") @db.VarChar(50)
  name         String         @db.VarChar(255)
  customerType CustomerType   @default(RETAIL) @map("customer_type")
  phone        String?        @db.VarChar(20)
  email        String?        @db.VarChar(255)
  address      String?        @db.Text
  status       CustomerStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  milkSales            MilkSale[]
  ledgerAccounts       LedgerAccount[]
  bills                Bill[]
  payments             Payment[]
  financialAdjustments FinancialAdjustment[]

  @@unique([branchId, customerCode])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@map("customers")
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  productCode   String        @map("product_code") @db.VarChar(50)
  name          String        @db.VarChar(255)
  category      String        @db.VarChar(100)
  unitOfMeasure String        @map("unit_of_measure") @db.VarChar(20)
  basePrice     Decimal       @map("base_price") @db.Decimal(12, 2)
  taxRate       Decimal       @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, productCode])
  @@index([tenantId])
  @@index([companyId])
  @@map("products")
}

// ==========================================
// MILK OPERATIONS DOMAIN
// ==========================================

model RateChart {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  branchId      String?       @map("branch_id") @db.Uuid
  name          String        @db.VarChar(100)
  code          String        @db.VarChar(50)
  type          RateChartType
  milkType      MilkType      @map("milk_type")
  baseRate      Decimal       @map("base_rate") @db.Decimal(10, 2)
  fatBase       Decimal?      @map("fat_base") @db.Decimal(5, 2)
  snfBase       Decimal?      @map("snf_base") @db.Decimal(5, 2)
  effectiveFrom DateTime      @map("effective_from")
  effectiveTo   DateTime?     @map("effective_to")
  status        RateStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  rateHistories        RateHistory[]
  appliedRateSnapshots AppliedRateSnapshot[]
  milkCollections      MilkCollection[]
  milkSales            MilkSale[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@map("rate_charts")
}

model RateHistory {
  id            String    @id @default(uuid()) @db.Uuid
  rateChartId   String    @map("rate_chart_id") @db.Uuid
  baseRate      Decimal   @map("base_rate") @db.Decimal(10, 2)
  fatBase       Decimal?  @map("fat_base") @db.Decimal(5, 2)
  snfBase       Decimal?  @map("snf_base") @db.Decimal(5, 2)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  changedBy     String?   @map("changed_by") @db.VarChar(255)
  reason        String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")

  rateChart RateChart @relation(fields: [rateChartId], references: [id], onDelete: Cascade)

  @@index([rateChartId])
  @@map("rate_histories")
}

model AppliedRateSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  rateChartId  String?  @map("rate_chart_id") @db.Uuid
  ratePerLiter Decimal  @map("rate_per_liter") @db.Decimal(10, 2)
  fatRate      Decimal? @map("fat_rate") @db.Decimal(10, 2)
  snfRate      Decimal? @map("snf_rate") @db.Decimal(10, 2)
  bonusRate    Decimal  @default(0.00) @map("bonus_rate") @db.Decimal(10, 2)
  deduction    Decimal  @default(0.00) @db.Decimal(10, 2)
  finalRate    Decimal  @map("final_rate") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  rateChart RateChart? @relation(fields: [rateChartId], references: [id], onDelete: SetNull)

  milkCollections MilkCollection[]
  milkSales       MilkSale[]

  @@index([rateChartId])
  @@map("applied_rate_snapshots")
}

model MilkQualityRecord {
  id        String   @id @default(uuid()) @db.Uuid
  fat       Decimal  @db.Decimal(5, 2)
  snf       Decimal  @db.Decimal(5, 2)
  clr       Decimal? @db.Decimal(5, 2)
  water     Decimal? @default(0.00) @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  milkCollections MilkCollection[]
  milkSales       MilkSale[]

  @@map("milk_quality_records")
}

model MilkCollection {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  farmerId              String    @map("farmer_id") @db.Uuid
  qualityRecordId       String?   @unique @map("quality_record_id") @db.Uuid
  appliedRateSnapshotId String?   @unique @map("applied_rate_snapshot_id") @db.Uuid
  rateChartId           String?   @map("rate_chart_id") @db.Uuid
  collectionDate        DateTime  @map("collection_date") @db.Date
  shift                 MilkShift
  milkType              MilkType  @map("milk_type")
  quantity              Decimal   @db.Decimal(10, 2)
  totalAmount           Decimal   @map("total_amount") @db.Decimal(12, 2)
  remarks               String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  farmer              Farmer               @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  qualityRecord       MilkQualityRecord?   @relation(fields: [qualityRecordId], references: [id], onDelete: SetNull)
  appliedRateSnapshot AppliedRateSnapshot? @relation(fields: [appliedRateSnapshotId], references: [id], onDelete: SetNull)
  rateChart           RateChart?           @relation(fields: [rateChartId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([farmerId])
  @@index([collectionDate, shift])
  @@map("milk_collections")
}

model MilkSale {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  customerId            String    @map("customer_id") @db.Uuid
  qualityRecordId       String?   @unique @map("quality_record_id") @db.Uuid
  appliedRateSnapshotId String?   @unique @map("applied_rate_snapshot_id") @db.Uuid
  rateChartId           String?   @map("rate_chart_id") @db.Uuid
  saleDate              DateTime  @map("sale_date") @db.Date
  shift                 MilkShift
  milkType              MilkType  @map("milk_type")
  quantity              Decimal   @db.Decimal(10, 2)
  totalAmount           Decimal   @map("total_amount") @db.Decimal(12, 2)
  remarks               String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  qualityRecord       MilkQualityRecord?   @relation(fields: [qualityRecordId], references: [id], onDelete: SetNull)
  appliedRateSnapshot AppliedRateSnapshot? @relation(fields: [appliedRateSnapshotId], references: [id], onDelete: SetNull)
  rateChart           RateChart?           @relation(fields: [rateChartId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([saleDate, shift])
  @@map("milk_sales")
}

// ==========================================
// FINANCIAL & LEDGER DOMAIN
// ==========================================

model LedgerAccount {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  accountType    AccountType @map("account_type")
  accountCode    String      @map("account_code") @db.VarChar(50)
  name           String      @db.VarChar(255)
  farmerId       String?     @map("farmer_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  currentBalance Decimal     @default(0.00) @map("current_balance") @db.Decimal(14, 2)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  farmer   Farmer?   @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@unique([branchId, accountCode])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([farmerId])
  @@index([customerId])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  entryType       EntryType @map("entry_type")
  amount          Decimal   @db.Decimal(12, 2)
  balanceAfter    Decimal   @map("balance_after") @db.Decimal(14, 2)
  transactionDate DateTime  @map("transaction_date")
  referenceType   String    @map("reference_type") @db.VarChar(50)
  referenceId     String?   @map("reference_id") @db.VarChar(255)
  description     String?   @db.Text
  isReversed      Boolean   @default(false) @map("is_reversed")
  reversedById    String?   @map("reversed_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([accountId])
  @@index([referenceType, referenceId])
  @@index([transactionDate])
  @@map("ledger_entries")
}

model Bill {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  branchId        String     @map("branch_id") @db.Uuid
  billType        BillType   @map("bill_type")
  billNumber      String     @map("bill_number") @db.VarChar(50)
  farmerId        String?    @map("farmer_id") @db.Uuid
  customerId      String?    @map("customer_id") @db.Uuid
  periodStart     DateTime   @map("period_start") @db.Date
  periodEnd       DateTime   @map("period_end") @db.Date
  grossAmount     Decimal    @map("gross_amount") @db.Decimal(12, 2)
  totalDeductions Decimal    @default(0.00) @map("total_deductions") @db.Decimal(12, 2)
  totalIncentives Decimal    @default(0.00) @map("total_incentives") @db.Decimal(12, 2)
  netAmount       Decimal    @map("net_amount") @db.Decimal(12, 2)
  paidAmount      Decimal    @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  status          BillStatus @default(DRAFT)
  revisionNumber  Int        @default(1) @map("revision_number")
  parentBillId    String?    @map("parent_bill_id") @db.Uuid
  isFinalized     Boolean    @default(false) @map("is_finalized")
  finalizedAt     DateTime?  @map("finalized_at")
  remarks         String?    @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  farmer   Farmer?   @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  parentBill Bill?  @relation("BillRevisions", fields: [parentBillId], references: [id], onDelete: Restrict)
  childBills Bill[] @relation("BillRevisions")

  billItems            BillItem[]
  paymentAllocations   PaymentAllocation[]
  financialAdjustments FinancialAdjustment[]

  @@unique([branchId, billNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([farmerId])
  @@index([customerId])
  @@index([parentBillId])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(uuid()) @db.Uuid
  billId      String   @map("bill_id") @db.Uuid
  itemType    String   @map("item_type") @db.VarChar(50)
  referenceId String?  @map("reference_id") @db.VarChar(255)
  description String   @db.VarChar(255)
  quantity    Decimal? @db.Decimal(10, 2)
  rate        Decimal? @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([itemType, referenceId])
  @@map("bill_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  paymentType     PaymentType   @map("payment_type")
  paymentNumber   String        @map("payment_number") @db.VarChar(50)
  farmerId        String?       @map("farmer_id") @db.Uuid
  customerId      String?       @map("customer_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  paymentMode     PaymentMode   @map("payment_mode")
  paymentDate     DateTime      @map("payment_date") @db.Date
  status          PaymentStatus @default(COMPLETED)
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  remarks         String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  farmer   Farmer?   @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  paymentAllocations PaymentAllocation[]

  @@unique([branchId, paymentNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([farmerId])
  @@index([customerId])
  @@index([paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  billId          String?  @map("bill_id") @db.Uuid
  amountAllocated Decimal  @map("amount_allocated") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bill    Bill?   @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([billId])
  @@map("payment_allocations")
}

model FinancialAdjustment {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  adjustmentNumber String         @map("adjustment_number") @db.VarChar(50)
  adjustmentType   AdjustmentType @map("adjustment_type")
  farmerId         String?        @map("farmer_id") @db.Uuid
  customerId       String?        @map("customer_id") @db.Uuid
  billId           String?        @map("bill_id") @db.Uuid
  amount           Decimal        @db.Decimal(12, 2)
  reason           String         @db.Text
  approvedBy       String?        @map("approved_by") @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  farmer   Farmer?   @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bill     Bill?     @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([branchId, adjustmentNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([farmerId])
  @@index([customerId])
  @@index([billId])
  @@map("financial_adjustments")
}

model FinancialRevision {
  id             String   @id @default(uuid()) @db.Uuid
  entityName     String   @map("entity_name") @db.VarChar(100)
  entityId       String   @map("entity_id") @db.VarChar(255)
  revisionNumber Int      @map("revision_number")
  previousData   Json     @map("previous_data")
  newData        Json     @map("new_data")
  reason         String   @db.Text
  revisedBy      String?  @map("revised_by") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityName, entityId])
  @@map("financial_revisions")
}
